{
  "name": "@webship.co/workspace-libraries",
  "version": "1.0.0-alpha1",
  "description": "The Libraries workspace for Webship Workspace: the `libraries/` folder (type code), its settings file, its 6 commands and its docs, activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-libraries.git"
  },
  "files": [
    "dist/src",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "libraries",
    "label": "Libraries",
    "workspace": {
      "key": "libraries",
      "settingsTemplate": "config/workspace.libraries.settings.yml",
      "files": [
        "commands/cmd-tool-git-change-filemode-to-false.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-graphify.sh",
        "commands/cmd-tools-obsidian.sh",
        "commands/cmd-tools-ragify.sh",
        "commands/cmd-tools-reclaim.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "features": [
      "features/libraries.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.0-alpha1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
